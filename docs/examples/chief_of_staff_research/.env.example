# Copy this file to .env and fill in your values.

# LLM provider
OPENAI_API_KEY=sk-...
AGENT_SETTING_CONFIG=settings.openai.toml

# Optional: override model / endpoint (Azure, IBM LiteLLM, etc.)
# MODEL_NAME=Azure/gpt-5-2025-08-07
# OPENAI_BASE_URL=https://your-litellm-endpoint
# OPENAI_API_VERSION=2025-08-07

# Slack credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Socket Mode — no public URL needed
CUGA_SLACK_SOCKET_MODE=true
CUGA_SLACK_ENABLE=true

# Langfuse observability (optional)
# Get keys at https://cloud.langfuse.com or your self-hosted instance
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Dashboard port (default 7860)
# DASHBOARD_PORT=7860
