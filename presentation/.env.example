# LLM fallback — unknown keywords improvise a slide via an
# OpenAI-compatible chat completions endpoint. Same wire format
# CUGA uses, so you can point at the same LiteLLM proxy with the
# same credentials.
#
# Leave VITE_OPENAI_API_KEY unset and authored slides still work;
# unknown keywords show a friendly "no fallback configured" message.

VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://ete-litellm.bx.cloud9.ibm.com
VITE_MODEL_NAME=aws/claude-haiku-4-5
