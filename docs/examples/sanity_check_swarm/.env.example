# Copy this file to .env and fill in YOUR (second) Slack bot credentials.
# Jim's chief_of_staff_research swarm uses Bot 1.
# This swarm (sanity_check_swarm) uses Bot 2 — different tokens, same workspace.

# LLM provider
OPENAI_API_KEY=sk-...
AGENT_SETTING_CONFIG=settings.openai.toml

# Optional: override model / endpoint (Azure, IBM LiteLLM, etc.)
# MODEL_NAME=Azure/gpt-5-2025-08-07
# OPENAI_BASE_URL=https://your-litellm-endpoint
# OPENAI_API_VERSION=2025-08-07

# Slack credentials — YOUR second bot (different from Jim's Bot 1)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
SLACK_FORCE_THREADED=true
SLACK_UNFURL_LINKS=false
SLACK_UNFURL_MEDIA=false

# Socket Mode — no public URL needed
CUGA_SLACK_SOCKET_MODE=true
CUGA_SLACK_ENABLE=true

# Langfuse observability (optional)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Dashboard port — 7861 to avoid clash with Jim's swarm on 7860
# DASHBOARD_PORT=7861
